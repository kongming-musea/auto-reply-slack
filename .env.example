# Slack app credentials (api.slack.com → your app → Basic Information / Install App)
SLACK_BOT_TOKEN=xoxb-your-bot-token
SLACK_USER_TOKEN=xoxp-your-user-token
SLACK_SIGNING_SECRET=your-signing-secret

# Your Slack user ID (Profile → ⋮ → Copy member ID, e.g. U01ABCDEFG)
KONG_MING_USER_ID=U01ABCDEFG

# claude -p configuration (uses local Cowork / Pro / Max session — no API key)
CLAUDE_BIN=claude
CLAUDE_TIMEOUT=600
CLAUDE_CWD=/Users/your-username

# Catchup scanner (defaults shown)
# CATCHUP_INTERVAL_SECONDS=300       # how often to drain queue + scan DMs
# CATCHUP_LOOKBACK_HOURS=24          # how far back DM scan looks
# CATCHUP_STARTUP_DELAY_SECONDS=20   # wait this long after boot before first scan
# CATCHUP_HISTORY_LIMIT=50           # max messages per DM checked per scan
